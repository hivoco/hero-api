# ─── Hero Destini backend environment (TEMPLATE — safe to commit) ───
# Copy to `.env` and fill in real values. NEVER put real secrets in this file.

# Database (MySQL 8). The hero_destini schema is in sql/schema.sql.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/hero_destini

# Phone privacy
# PHONE_HASH_SALT: any long random string.
# FERNET_KEY: generate with  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_HASH_SALT=change-me-to-a-long-random-salt
FERNET_KEY=PASTE_A_GENERATED_FERNET_KEY_HERE

# OTP
OTP_EXPIRY_MINUTES=5

# AWS / S3 (leave keys empty on EC2 to use the instance IAM role)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=hero-destini-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Groq vision API keys for photo validation (comma-separated for more throughput)
GROQ_API_KEYS=key1,key2,key3

# Optional vision providers — only needed if you switch vision_config.provider
# to 'openai' (ChatGPT) or 'google' (Gemini) from the admin Vision Model page.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Redis (localhost for dev; ElastiCache endpoint in prod)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WhatsApp via Yellow.ai engagements API (real OTP + confirmation messages).
# Fill BOT_ID / API_KEY / SENDER from the Yellow.ai console — keep them secret.
YELLOW_API_URL=https://cloud.yellow.ai/api/engagements/notifications/v2/push
YELLOW_BOT_ID=REPLACE_BOT_ID
YELLOW_API_KEY=REPLACE_ME
YELLOW_SENDER=REPLACE_SENDER_NUMBER
YELLOW_OTP_TEMPLATE=otp_message_v1
YELLOW_CONFIRM_TEMPLATE=destini_tech_act_wait_v1
# Optional — set once approved on Yellow.ai (blank = message skipped):
YELLOW_FAILED_TEMPLATE=failed_message
YELLOW_VIDEO_TEMPLATE=destini_tech_act_video_v1

# App
APP_ENV=development
CONSENT_VERSION=v1-dpdp-2026
MAX_VIDEOS_PER_USER=2

# Admin auth
# ADMIN_PASSWORD_HASH: bcrypt hash. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=PASTE_A_BCRYPT_HASH_HERE
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Server-to-server key the pipeline worker uses to call admin job APIs
INTERNAL_API_KEY=change-me-to-a-long-random-internal-key
